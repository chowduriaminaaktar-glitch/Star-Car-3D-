<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StarCar3D" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/sc_bg_dark</item>
        <item name="android:colorBackground">@color/sc_bg_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.StarCar3D.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sc_bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.StarCar3D</item>
    </style>
</resources>
